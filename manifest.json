{
  "manifest_version": 3,
  "name": "구름 근무시간",
  "version": "1.4.1",
  "description": "아마란스 근태 API로 이번 달 인정근무·소정근로·남은 근무시간을 계산합니다.",
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://gw.goorm.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gw.goorm.io/*"
      ],
      "js": [
        "src/lib/time.js",
        "src/lib/holidays.js",
        "src/lib/gwapi.js",
        "src/lib/store.js",
        "src/lib/calc.js",
        "src/lib/updater.js",
        "src/lib/leaveform.js",
        "src/content.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "구름 근무시간",
    "default_popup": "src/popup.html"
  }
}
